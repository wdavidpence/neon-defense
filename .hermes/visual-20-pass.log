const { chromium } = require('/Users/davidpence/.hermes/hermes-agent/apps/desktop/node_modules/playwright');
(async () => {
  const browser = await chromium.launch({ args: ['--no-sandbox'] });
  const page = await browser.newPage({ viewport: { width: 375, height: 812 } });
  const errors = [];
  page.on('console', msg => { if (msg.type() === 'error') errors.push(msg.text()); });
  page.on('pageerror', err => errors.push(err.message));
  try {
    await page.goto('http://localhost:8765/index.html', { waitUntil: 'networkidle', timeout: 15000 });
    await page.waitForTimeout(2500);
    const title = await page.title();
    const canvas = await page.\$('#gameCanvas');
    const rect = canvas ? await canvas.boundingBox() : null;
    console.log('title:', title);
    console.log('canvas present:', !!canvas, 'rect:', JSON.stringify(rect));
    console.log('console errors:', errors.length);
    errors.forEach(e => console.log('  ERR:', e));
  } catch(e) { console.error('probe error:', e.message); }
  await browser.close();
  process.exit(errors.length === 0 ? 0 : 1);
})();
" 2>&1

